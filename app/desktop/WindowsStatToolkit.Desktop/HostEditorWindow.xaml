<Window x:Class="WindowsStatToolkit.Desktop.HostEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC connection"
        Height="620"
        Width="620"
        MinHeight="560"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8F4EA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="PC connection settings" FontSize="22" FontWeight="Bold" Foreground="#153448" />

                <TextBlock Grid.Row="1" Margin="0,14,0,0" Text="PC name" />
                <TextBox Grid.Row="2" x:Name="NameTextBox" />

                <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="IP address or DNS name" />
                <TextBox Grid.Row="4" x:Name="AddressTextBox" />

                <TextBlock Grid.Row="5" Margin="0,10,0,0" Text="SSH user" />
                <TextBox Grid.Row="6" x:Name="UserTextBox" />

                <UniformGrid Grid.Row="7" Columns="2" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="SSH port" />
                        <TextBox x:Name="PortTextBox" Text="22" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="SSH key path" />
                        <TextBox x:Name="KeyPathTextBox" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Grid.Row="8" Margin="0,10,0,0" Text="Remote shell" />
                <TextBox Grid.Row="9" x:Name="ShellTextBox" Text="powershell.exe" />

                <UniformGrid Grid.Row="10" Columns="2" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Tags" />
                        <TextBox x:Name="TagsTextBox" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Disk alert threshold, GB" />
                        <TextBox x:Name="DiskThresholdTextBox" Text="10" />
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Grid.Row="11" Columns="2" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Ping failures before alert" />
                        <TextBox x:Name="PingFailuresTextBox" Text="3" />
                    </StackPanel>
                    <StackPanel Margin="8,20,0,0">
                        <CheckBox x:Name="MonitoringEnabledCheckBox" Content="Enable monitoring for this PC" IsChecked="True" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Grid.Row="12" Margin="0,10,0,0" Text="Notes" />
                <TextBox Grid.Row="13" x:Name="NotesTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </ScrollViewer>

        <WrapPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" Padding="14,8" />
            <Button x:Name="SaveButton" Content="Save PC" Padding="14,8" />
        </WrapPanel>
    </Grid>
</Window>
